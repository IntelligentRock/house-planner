# Copy to .env.local for local development (`cp .env.example .env.local`).
# In Vercel, add the same variables under Project → Settings → Environment Variables.

# Supabase project URL and publishable key (Dashboard → Project Settings → API Keys).
# Safe to expose to the browser: all data access is enforced by Row Level Security.
# A legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret (service-role) key. ONLY for the operator scripts in scripts/ (admin bootstrap,
# export). The web app never uses it. Do NOT add it to Vercel, and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public URL of the site, used for sign-in email links. Leave unset to use the request host
# (useful for Vercel preview deployments).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the header, page titles and emails.
NEXT_PUBLIC_HOUSE_NAME=The Family House
